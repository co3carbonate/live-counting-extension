    "start_uuid": {
      "help": "Update uuid to start from. Inclusive. Defaults to the first count. Rarely needed.",
      "example": "26bf2c4e-9abc-11f1-9cdd-ee96a519794e"
    },
    "end_uuid": {
      "help": "Update uuid to stop at. Exclusive. Defaults to the last count. Rarely needed.",
      "example": "26bf2c4e-9abc-11f1-9cdd-ee96a519794e"
    },
    "update_id": {
      "help": "The uuid of a single update.",
      "example": "26bf2c4e-9abc-11f1-9cdd-ee96a519794e"
    },
    "start_count": {
      "help": "Count to start from. Inclusive. Defaults to the first count.",
      "example": "1000000"
    },
    "end_count": {
      "help": "Count to stop at. Exclusive. Defaults to the last count.",
      "example": "2000000"
    },
    "start_num": {
      "help": "Number to start from. Inclusive. Defaults to the first count.",
      "example": "1000000"
    },
    "end_num": {
      "help": "Number to stop at. Exclusive. Defaults to the last count.",
      "example": "2000000"
    },
    "start_k": {
      "help": "K to start from. Inclusive. Defaults to the first count.",
      "example": "1000"
    },
    "end_k": {
      "help": "K to stop at. Exclusive. Defaults to the last count.",
      "example": "2000"
    },
    "start_get": {
      "help": "Get to start from. Inclusive. Defaults to the first count.",
      "example": "1000"
    },
    "ending_get": {
      "help": "Get to stop at. Exclusive. Defaults to the last count.",
      "example": "2000"
    },
    "number": {
      "help": "A count as it appears in the thread.",
      "example": "11000000"
    },
    "url": {
      "help": "Permalink to a single update.",
      "example": "https://www.reddit.com/live/ta535s1hq2je/updates/26bf2c4e-9abc-11f1-9cdd-ee96a519794e"
    },
    "start_date": {
      "help": "Start date. Use yyyy-mm-dd, yyyy-mm or yyyy depending on whether the stat is daily, monthly or yearly. Inclusive.",
      "example": "2024-03-15"
    },
    "end_date": {
      "help": "End date. Use yyyy-mm-dd, yyyy-mm or yyyy depending on whether the stat is daily, monthly or yearly. Exclusive.",
      "example": "2024-04-01"
    },
    "yyyy-mm-dd": {
      "help": "The day to report on.",
      "example": "2024-03-15"
    }
