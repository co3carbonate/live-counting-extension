  "argTypes": {
    "context": {
      "help": "Number from 1-10. Shows a range of positions around the position occupied by <username> or <position>. Omitting it entirely uses 3.",
      "values": [
        {
          "value": "3",
          "label": "default"
        },
        {
          "value": "1"
        },
        {
          "value": "2"
        },
        {
          "value": "4"
        },
        {
          "value": "5"
        },
        {
          "value": "6"
        },
        {
          "value": "7"
        },
        {
          "value": "8"
        },
        {
          "value": "9"
        },
        {
          "value": "10"
        }
      ]
    },
    "alts_combined": {
      "help": "Integer. 0 calculates the stat normally, anything else combines alts.",
      "values": [
        {
          "value": "0",
          "label": "default - separate alts"
        },
        {
          "value": "1",
          "label": "combine alts"
        }
      ]
    },
    "is_current": {
      "help": "Integer, for streak stats. 0 calculates normally, anything else only outputs current streaks.",
      "values": [
        {
          "value": "0",
          "label": "default - all streaks"
        },
        {
          "value": "1",
          "label": "current streaks only"
        }
      ]
    },
    "day_counts_combined": {
      "help": "Integer. Non-zero combines daily counts across threads before calculating (default). 0 calculates each thread separately, then combines.",
      "values": [
        {
          "value": "1",
          "label": "default - combine first"
        },
        {
          "value": "0",
          "label": "per thread, then combine"
        }
      ]
    },
    "mode": {
      "help": "Exacta type. 0 (default) is any type.",
      "values": [
        {
          "value": "0",
          "label": "default - any exacta"
        },
        {
          "value": "1",
          "label": "chalupa"
        },
        {
          "value": "2",
          "label": "poonxacta"
        },
        {
          "value": "3",
          "label": "trejexacta"
        }
      ]
    },
    "username": {
